# da Salon Partner API. Keep the key server-side: never prefix it with NEXT_PUBLIC_.
DASALON_API_BASE_URL=https://partner-host.example.com/partner-api/api/v1
DASALON_PARTNER_API_KEY=x-partner-api-key

# Optional, local development only: without the key above, read the live menu and
# availability from a deployed Brand Home instead. Booking submission stays disabled.
# DASALON_DEV_PROXY_URL=https://da-salon-templates.vercel.app
